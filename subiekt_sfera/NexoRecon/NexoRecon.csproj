<Project Sdk="Microsoft.NET.Sdk">
  <!--
    NexoRecon: skrypt ROZPOZNAWCZY Sfery nexo (tylko odczyt, nic nie zapisuje).
    Przepis z SDK: import SferaConsoleApp.targets ustawia net8.0-windows / win-x64 /
    referencje do Bin SDK i kopiuje ijwhost.dll + Xml.pak + SNI.dll do wyjscia.
    SDK lezy w C:\iLogic\SUBIEKT (patrz SUBIEKT_INTEGRACJA_PLAN.md).
  -->
  <PropertyGroup>
    <!--
      SDK Sfery: C:\iLogic\SUBIEKT\ — ten sam katalog na KAŻDYM stanowisku,
      wgrywany przy instalacji (Bin\ + Narzedzia\, ~1,1 GB). Wcześniej
      ścieżka wskazywała na rozpakowaną dokumentację
      (C:\iLogic\Subiekt_nexo_PRO_dokumentacja\SDK\), której nazwa niesie
      numer wersji i nie na każdym stanowisku wygląda tak samo.
      Stara lokalizacja działa dalej jako zapas — patrz warunek niżej.
    -->
    <nexoSdkRoot Condition="Exists('C:\iLogic\SUBIEKT\Narzedzia\Targets\SferaConsoleApp.targets')">C:\iLogic\SUBIEKT\</nexoSdkRoot>
    <nexoSdkRoot Condition="'$(nexoSdkRoot)' == ''">C:\iLogic\Subiekt_nexo_PRO_dokumentacja\SDK\</nexoSdkRoot>
    <nexoSdkBinPath>$(nexoSdkRoot)Bin\</nexoSdkBinPath>
    <nexoSdkNarzedziaPath>$(nexoSdkRoot)Narzedzia\</nexoSdkNarzedziaPath>
    <AssemblyName>NexoRecon</AssemblyName>
    <RootNamespace>NexoRecon</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SelfContained>false</SelfContained>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SatelliteResourceLanguages>pl;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <Import Project="$(nexoSdkNarzedziaPath)Targets\SferaConsoleApp.targets" />

  <!--
    BIBLIOTEKI InsERT NIE TRAFIAJA DO WYJSCIA (Private=false).

    Sfera odmawia polaczenia, gdy wersja bibliotek != wersja bazy:
        "Wersja bazy danych to 61.1.1.9471, a wersja Sfery to 61.1.0.9431"
    Baza aktualizuje sie SAMA przy uruchomieniu Subiekta, a kopia bibliotek
    zostaje na starej wersji — most startuje, odpowiada na ping, ale nigdy
    nie osiaga ready. RM_BAZA wisi wtedy na przejeciu locka (09.09.2026).

    Kopiowanie ich obok .exe mialo dodatkowy skutek uboczny: .NET laduje
    biblioteke z katalogu aplikacji ZANIM odezwie sie hook Resolving
    z SdkLoader, wiec zadne wykrywanie nowszej wersji nie mialo szans.

    Teraz referencje sluza WYLACZNIE kompilacji, a w runtime biblioteki
    laduje hook — z instalacji Subiekta (zawsze zgodna z baza) albo z kopii
    statycznej, gdy Subiekta na maszynie nie ma. Patrz SdkLoader.cs.

    Efekt uboczny: katalog wyjsciowy chudnie z ~590 MB do kilkuset KB.
  -->
  <Target Name="NieKopiujBibliotekInsERT" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="$([System.String]::Copy('%(Filename)').StartsWith('InsERT.'))" />
    </ItemGroup>
  </Target>
</Project>
