<Project Sdk="Microsoft.NET.Sdk">
  <!--
    NexoRecon: skrypt ROZPOZNAWCZY Sfery nexo (tylko odczyt, nic nie zapisuje).
    Przepis z SDK: import SferaConsoleApp.targets ustawia net8.0-windows / win-x64 /
    referencje do Bin SDK i kopiuje ijwhost.dll + Xml.pak + SNI.dll do wyjscia.
    SDK lezy w C:\iLogic\SUBIEKT (patrz SUBIEKT_INTEGRACJA_PLAN.md).
  -->
  <PropertyGroup>
    <!--
      SDK Sfery: C:\iLogic\SUBIEKT\ — ten sam katalog na KAŻDYM stanowisku,
      wgrywany przy instalacji (Bin\ + Narzedzia\, ~1,1 GB). Wcześniej
      ścieżka wskazywała na rozpakowaną dokumentację
      (C:\iLogic\Subiekt_nexo_PRO_dokumentacja\SDK\), której nazwa niesie
      numer wersji i nie na każdym stanowisku wygląda tak samo.
      Stara lokalizacja działa dalej jako zapas — patrz warunek niżej.
    -->
    <nexoSdkRoot Condition="Exists('C:\iLogic\SUBIEKT\Narzedzia\Targets\SferaConsoleApp.targets')">C:\iLogic\SUBIEKT\</nexoSdkRoot>
    <nexoSdkRoot Condition="'$(nexoSdkRoot)' == ''">C:\iLogic\Subiekt_nexo_PRO_dokumentacja\SDK\</nexoSdkRoot>
    <nexoSdkBinPath>$(nexoSdkRoot)Bin\</nexoSdkBinPath>
    <nexoSdkNarzedziaPath>$(nexoSdkRoot)Narzedzia\</nexoSdkNarzedziaPath>
    <AssemblyName>NexoRecon</AssemblyName>
    <RootNamespace>NexoRecon</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SelfContained>false</SelfContained>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SatelliteResourceLanguages>pl;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <Import Project="$(nexoSdkNarzedziaPath)Targets\SferaConsoleApp.targets" />

  <!--
    BIBLIOTEKI InsERT NIE TRAFIAJA DO WYJSCIA (Private=false).

    Sfera odmawia polaczenia, gdy wersja bibliotek != wersja bazy:
        "Wersja bazy danych to 61.1.1.9471, a wersja Sfery to 61.1.0.9431"
    Baza aktualizuje sie SAMA przy uruchomieniu Subiekta, a kopia bibliotek
    zostaje na starej wersji — most startuje, odpowiada na ping, ale nigdy
    nie osiaga ready. RM_BAZA wisi wtedy na przejeciu locka (09.09.2026).

    Kopiowanie ich obok .exe mialo dodatkowy skutek uboczny: .NET laduje
    biblioteke z katalogu aplikacji ZANIM odezwie sie hook Resolving
    z SdkLoader, wiec zadne wykrywanie nowszej wersji nie mialo szans.

    Teraz referencje sluza WYLACZNIE kompilacji, a w runtime biblioteki
    laduje hook — z instalacji Subiekta (zawsze zgodna z baza) albo z kopii
    statycznej, gdy Subiekta na maszynie nie ma. Patrz SdkLoader.cs.

    Efekt uboczny: katalog wyjsciowy chudnie z ~590 MB do kilkuset KB.
  -->
  <Target Name="NieKopiujBibliotekInsERT" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="$([System.String]::Copy('%(Filename)').StartsWith('InsERT.'))" />
    </ItemGroup>
  </Target>

  <!--
    SIEDEM BIBLIOTEK POD WYDRUK PDF — TWARDE DOWIAZANIA, NIE KOPIE.

    Silnik wydruku (Stimulsoft, wzorzec ZD) NIE laduje przez .NET: sklada
    sciezke jako tekst (katalog .exe + nazwa) i czyta plik z dysku. Zaden hook
    rozwiazywania assembly tego nie przechwyci — sprawdzone 15.09.2026 na
    AssemblyLoadContext.Resolving, AppDomain.AssemblyResolve i APP_PATHS
    w runtimeconfig. Wszystkie trzy przeszly bez efektu: `Eksport()` NIE
    RZUCA WYJATKU, po prostu nic nie zapisuje. Objaw u uzytkownika: mail do
    dostawcy z rysunkami, ale bez PDF-a zamowienia.
    Diagnoza: tryb `wydruk-recon`, pole `bledy_wydruku`.

    Skoro plik MUSI fizycznie lezec obok .exe, klademy tam dowiazanie twarde
    (hardlink) — drugi wpis katalogowy do TEGO SAMEGO pliku, wiec:
      * dla Stimulsoftu plik istnieje i ma poprawna tresc,
      * nie ma drugiej kopii, ktora zamrozilaby wersje.

    ⚠️ DLACZEGO NIE ZWYKLA KOPIA. Kopia zostaje na starej wersji, a baza
    aktualizuje sie sama przy starcie Subiekta. Sfera odmawia wtedy
    polaczenia ("Wersja bazy danych to 61.1.1.9471, a wersja Sfery to
    61.1.0.9431"), most startuje, odpowiada na ping, ale NIGDY nie osiaga
    ready, a RM_BAZA wisi na przejeciu locka (awaria z 09.09.2026).
    Do tego .NET laduje z katalogu aplikacji ZANIM odezwie sie hook, wiec
    kopia zabija tez wykrywanie nowszych bibliotek w SdkLoader.

    ⚠️ Hardlink nie wymaga uprawnien administratora (symlink WYMAGA — nie
    uzywac). Dziala tylko w obrebie jednego wolumenu; SDK i repo sa na C:.
    Gdy sie nie uda (inny dysk, system plikow bez twardych dowiazan),
    schodzimy na kopie: lepiej dzialajacy wydruk niz zaden, a SdkLoader i tak
    zglosi niezgodnosc wersji czytelnym komunikatem.

    ⚠️ ClickOnce przy aktualizacji PODMIENIA pliki, wiec dowiazanie moze
    zostac przy starej wersji. Dlatego zakladamy je na nowo przy KAZDYM
    buildzie, a most ma wlasne odswiezanie przy starcie (SdkLoader).
  -->
  <Target Name="DowiazBibliotekiWydruku" AfterTargets="Build">
    <PropertyGroup>
      <!-- Ta sama lista co SdkLoader._bibliotekiWydruku (9 pozycji: 7 InsERT
           + 2 Stimulsoft). Most zaklada je tez sam przy starcie — build robi
           to z wyprzedzeniem, zeby PDF dzialal juz przy PIERWSZYM
           uruchomieniu, a nie dopiero przy drugim. -->
      <_wydrukDll>InsERT.Moria.Narzedzia;InsERT.Mox.Core;InsERT.Moria.API;InsERT.Mox.EntityFrameworkSupport;InsERT.Moria.ModelDanych;InsERT.Moria.PolaWlasne;InsERT.Mox.EntityFramework.Core;Stimulsoft.Base;Stimulsoft.Report</_wydrukDll>
    </PropertyGroup>
    <ItemGroup>
      <_WydrukDll Include="$(_wydrukDll)" />
    </ItemGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\dowiaz_biblioteki_wydruku.ps1&quot; -Wyjscie &quot;$(TargetDir.TrimEnd('\'))&quot; -SdkBin &quot;$(nexoSdkBinPath.TrimEnd('\'))&quot; -Biblioteki &quot;$(_wydrukDll)&quot;"
          ContinueOnError="true" />
  </Target>
</Project>
